{
  "name": "decaid-pureflow",
  "version": "0.8.0",
  "description": "A minimal landscape, dark skin for the DE1: espresso with a live graph, an editor for A-Flow 3.0 profiles, a steam timer set from the milk's weight, and a shot history.",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "author": "Janek",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jan3kJ/decaid-pureflow.git"
  },
  "scripts": {
    "dev": "vite",
    "dev:ocr": "vite --mode ocr",
    "build": "npm run build:base && npm run build:ocr",
    "build:base": "vite build",
    "build:ocr": "vite build --mode ocr",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "zip": "npm run build && node scripts/zip.mjs",
    "fetch-ocr-models": "node scripts/fetch-ocr-models.mjs",
    "e2e": "playwright test",
    "e2e:ocr": "playwright test --config playwright.ocr.config.ts",
    "e2e:rig": "playwright test --config playwright.rig.config.ts",
    "lint": "eslint . && node scripts/font-sizes.mjs && node scripts/spacing.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "screenshots": "node scripts/screenshots.mjs",
    "docs-check": "node scripts/docs-check.mjs",
    "publish-check": "node scripts/publish-check.mjs",
    "verify": "node scripts/verify.mjs",
    "release": "node scripts/release.mjs",
    "type-sizes": "node scripts/type-sizes.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@paddleocr/paddleocr-js": "^0.4.2",
    "@playwright/test": "^1.64.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
